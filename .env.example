# Copy to .env. scripts/register_with_aom.py fills in the AOM_* values for you.

# --- Couchbase Agent Operations Manager -------------------------------------
# AOM as reached from the backend container (AOM's own compose stack, same machine).
AOM_URL=https://host.docker.internal:8090
# The AOM dashboard as your browser reaches it (linked from the story page at :8084/story).
AOM_DASHBOARD_URL=https://localhost
# Issued by register_with_aom.py (POST /v1/agents) - the "Harborline Assistant" agent.
AOM_AGENT_API_KEY=
# Issued by register_with_aom.py too - the six specialist agents (claims, roadside, billing, DriveWell, wellness,
# coverage), as a JSON map of agent id -> key. Each runs the Confirms in its area, with Agent Memory.
AOM_SPECIALIST_AGENT_KEYS=
# AOM dashboard admin - used only to publish Knowledge Base documents from the nightly export.
AOM_ADMIN_USERNAME=admin
AOM_ADMIN_PASSWORD=
# Optional: pin the LLM AOM routes completions to (otherwise AOM's configured default).
AOM_LLM_PROVIDER=
AOM_LLM_MODEL=
# AOM serves a self-signed cert by default.
AOM_VERIFY_TLS=false

# --- Knowledge Base publishing (daily) ----------------------------------------
KB_PROFILE_LIMIT=150

# --- Sync Gateway URL handed to the phone -------------------------------------
# Leave blank to use the app's EXPO_PUBLIC_SG_URL. For a physical phone use your Mac's LAN IP.
SG_PUBLIC_URL=

# --- Demo clock ----------------------------------------------------------------
# Blank = the export's export_date, so "renews in 21 days" stays the same whenever you demo.
DEMO_TODAY=

APP_SECRET=change-me-for-anything-shared
